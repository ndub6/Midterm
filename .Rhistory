Missing_Location <- is.na(Closures_Adjusted$LOCATION) | trimws(Closures_Adjusted$LOCATION) == ""
Missing_NAICS <- is.na(Closures_Adjusted$NAICS) | trimws(Closures_Adjusted$NAICS) == ""
Table <- data.frame(Characteristic = c("Business-Location Closures", "Earliest Closure Date", "Latest Closure Date", "Unique Location Accounts", "Unique Business Name", "Missing NAICS Codes", "Missing Industry Descriptions", "Missing Locations"), Value = c(format(nrow(Closures_Adjusted), big.mark = ","), format(min(Closures_Adjusted$LOCATION.END.DATE, na.rm = TRUE)), format(max(Closures_Adjusted$LOCATION.END.DATE, na.rm = TRUE)), format(length(unique(Closures_Adjusted$LOCATION.ACCOUNT..)), big.mark = ","), format(length(unique(Closures_Adjusted$BUSINESS.NAME)), big.mark = ","), paste0(format(sum(Missing_Industry),big.mark = ",")," (",round(100 * mean(Missing_Industry),1),"%)"),paste0(format(sum(Missing_Location),big.mark = ",")," (",round(100 * mean(Missing_Location),1),"%)"),paste0(format(sum(Missing_NAICS),big.mark = ",")," (",round(100 * mean(Missing_NAICS),1),"%)")))
knitr::kable(Table, col.names = c("Dataset Characteristic", "Value"), caption = "Business-Closure Characterisitcs (Adjusted Data)")

barplot(Yearly_Closures$Closures, names.arg = Yearly_Closures$Year, las = 2, col = "blue", xlab = "Closure Year", ylab = "Number of Closures", main = "Business-Location Closures by Year (Adjusted Data)", sub = "Note: 2017 and 2026 are Incomplete Years.")
# Closures by Month (Historic Data)

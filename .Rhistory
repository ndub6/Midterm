District_Counts$Pre_vs_Pandemic_Difference <- District_Counts$Pandemic - District_Counts$`Pre-Pandemic`
District_Counts$Pre_vs_Pandemic_Percent <- ifelse(District_Counts$`Pre-Pandemic`>0, 100*( District_Counts$Pandemic / District_Counts$`Pre-Pandemic` - 1), NA)
District_Pre_vs_Pandemic <- District_Counts[order(abs(District_Counts$Pre_vs_Pandemic_Difference), decreasing = TRUE),]
District_Pre_vs_Pandemic <- head(District_Pre_vs_Pandemic,5)
District_Pre_vs_Pandemic <- District_Pre_vs_Pandemic[,c("Council District", "Pre-Pandemic", "Pandemic", "Difference", "Percent Change")]
